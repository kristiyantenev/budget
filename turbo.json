{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "build/libs/**", "build/classes/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@booleanone/resourceserver#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["BUDGET_RESOURCE_URI", "BUDGET_TOKEN_ISSUER_URI", "BUDGET_TOKEN_AUDIENCE"]
    },
    "@booleanone/web#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "BETTER_AUTH_URL",
        "BETTER_AUTH_SECRET",
        "BUDGET_OIDC_ISSUER",
        "BUDGET_OIDC_CLIENT_SECRET",
        "BUDGET_DATABASE_URL",
        "BUDGET_API_URL"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["build/test-results/**", "build/reports/tests/**"]
    },
    "@workspace/oxlint-plugin-react-best-practices#test": {
      "outputs": []
    },
    "@booleanone/web#test": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.test", ".env.test.local"],
      "env": [
        "BETTER_AUTH_URL",
        "BETTER_AUTH_SECRET",
        "BUDGET_OIDC_ISSUER",
        "BUDGET_OIDC_CLIENT_ID",
        "BUDGET_OIDC_CLIENT_SECRET"
      ]
    },
    "lint": {
      "outputs": [],
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/oxlint.config.ts",
        "$TURBO_ROOT$/packages/oxlint-config/**",
        "$TURBO_ROOT$/packages/oxlint-plugin-react-best-practices/**"
      ]
    },
    "@booleanone/resourceserver#lint": {
      "outputs": ["build/reports/checkstyle/**"]
    }
  },
  "ui": "tui",
  "globalPassThroughEnv": [
    "JAVA_HOME",
    "SDKMAN_DIR",
    "SDKMAN_CANDIDATES_DIR",
    "DOCKER_HOST",
    "DOCKER_CONTEXT",
    "TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE",
    "TESTCONTAINERS_HOST_OVERRIDE"
  ]
}
